# Copy to .env for local development. Never commit the real key.
FRIDAY_PROVIDER=fake
GEMINI_API_KEY=
# Tavily API key is needed only when opting into web search.
TAVILY_API_KEY=
FRIDAY_SEARCH_BACKEND=tavily
# Legacy optional fallback: FRIDAY_SEARCH_BACKEND=gemini
FRIDAY_SEARCH_MODEL=gemini-3.8-flash
FRIDAY_MODEL=gemini-3.8-live
FRIDAY_VOICE=Kore
FRIDAY_INPUT_SAMPLE_RATE=16000
FRIDAY_OUTPUT_SAMPLE_RATE=24000
FRIDAY_MAX_SESSION_SECONDS=300
FRIDAY_EVENT_QUEUE_SIZE=128
FRIDAY_LOG_LEVEL=INFO
